{
  "root": "frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_BACKEND_URL": "https://shoecraftify-production.up.railway.app"
  },
  "rewrites": [
    {
      "source": "/((?!.*\\.(glb|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp|json)).*)",
      "destination": "/index.html"
    }
  ]
}
